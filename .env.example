# Exemplo de Configuração de Ambiente para MangaDex_Downloader_CJrTools
# Renomeie para .env caso deseje personalizar configurações locais.
# NUNCA insira senhas ou credenciais sensíveis neste arquivo.

# Diretório padrão de saída para os downloads
MANGADEX_DL_OUTDIR=download

# Idioma padrão para mangás (ex: pt-br, en, es)
MANGADEX_DL_LANG=pt-br

# Número de downloads paralelos por capítulo (threads)
MANGADEX_DL_WORKERS=4

# Timeout de conexões de rede em segundos (connect, read)
MANGADEX_DL_TIMEOUT_CONNECT=10
MANGADEX_DL_TIMEOUT_READ=30
